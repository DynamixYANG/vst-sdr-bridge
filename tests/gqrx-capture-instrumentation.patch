@@ -158,6 +158,20 @@ int main(int argc, char *argv[])
         if (w.configOk)
         {
             w.show();
+            // Acceptance-only instrumentation: save this application's actual Qt-rendered
+            // spectrum/waterfall without desktop capture. RF and DSP code are unchanged.
+            const QString captureDir=qEnvironmentVariable("VST_GQRX_CAPTURE_DIR");
+            QTimer captureTimer;
+            int captureFrame=0;
+            if(!captureDir.isEmpty()) {
+                QDir().mkpath(captureDir);
+                w.resize(1400,900);
+                QObject::connect(&captureTimer,&QTimer::timeout,&w,[&]() {
+                    w.grab().save(captureDir+QString("/gqrx-render-%1.png").arg(captureFrame++,4,10,QChar('0')));
+                    if(QFile::exists(captureDir+"/close.request")) w.close();
+                });
+                captureTimer.start(30000);
+            }
             return_code = QApplication::exec();
         }
