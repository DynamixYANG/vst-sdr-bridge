# Local dependency caches and preserved history
/archive/*
!/archive/README.md
/work/*
!/work/README.md
/tools/*
!/tools/README.md
**/bin/
**/obj/
**/__pycache__/
*.pyc
/soapy-vst/build*/
/soapy-vst/nuget-pkgs/
/dist/*
!/dist/README.md
/docs/releases/2.1/*.zip
/docs/releases/2.1/SHA256SUMS.txt
*.user
.vs/

/docs/releases/2.2/*.zip
/docs/releases/2.2/SHA256SUMS.txt
/docs/releases/2.2.1/*.zip
/docs/releases/2.2.1/SHA256SUMS.txt

# Vendor bitfile is a local archive, not public GPL payload
/hardware/ni-pxie-5644r/local/*
!/hardware/ni-pxie-5644r/local/README.md
